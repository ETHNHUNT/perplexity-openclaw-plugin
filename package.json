{
  "name": "perplexity-openclaw-plugin",
  "version": "1.0.0",
  "description": "Standalone CLI tool and OpenClaw plugin for Perplexity AI integration with browser automation",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "perplexity-cli": "./dist/cli/index.js"
  },
  "scripts": {
    "dev": "tsx src/cli/index.ts",
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "cli": "tsx src/cli/index.ts",
    "prepare": "npm run build"
  },
  "keywords": [
    "perplexity",
    "openclaw",
    "cli",
    "ai",
    "search",
    "research",
    "automation",
    "puppeteer"
  ],
  "author": "ETHNHUNT",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ETHNHUNT/perplexity-openclaw-plugin.git"
  },
  "bugs": {
    "url": "https://github.com/ETHNHUNT/perplexity-openclaw-plugin/issues"
  },
  "homepage": "https://github.com/ETHNHUNT/perplexity-openclaw-plugin#readme",
  "dependencies": {
    "puppeteer": "^21.11.0",
    "axios": "^1.6.7",
    "commander": "^11.1.0",
    "chalk": "^5.3.0",
    "ora": "^8.0.1",
    "inquirer": "^9.2.15",
    "dotenv": "^16.4.5",
    "pino": "^8.19.0",
    "pino-pretty": "^10.3.1"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "vitest": "^1.3.1",
    "@types/node": "^20.11.19",
    "@types/inquirer": "^9.0.7",
    "@biomejs/biome": "^1.5.3",
    "@vitest/coverage-v8": "^1.3.1",
    "tsx": "^4.7.1"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
