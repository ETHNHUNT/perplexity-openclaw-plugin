# Perplexity
PERPLEXITY_BASE_URL=https://www.perplexity.ai
PERPLEXITY_API_URL=https://www.perplexity.ai/api

# Authentication
AUTH_STORAGE_PATH=~/.perplexity/credentials.json
AUTH_ENCRYPTION_KEY=your-secret-key-here-change-this
SESSION_TIMEOUT=86400000
ENCRYPTION_ENABLED=true

# Browser Automation
HEADLESS_BROWSER=true
BROWSER_TIMEOUT=30000
NAVIGATION_TIMEOUT=30000

# Logging
LOG_LEVEL=info
LOG_PRETTY=true

# OpenClaw Plugin
OPENCLAW_PORT=3000
OPENCLAW_HOST=localhost

# Performance
HTTP_TIMEOUT=10000
MAX_RETRIES=3
RETRY_DELAY=1000

# Pro Features
ENABLE_PRO_FEATURES=false
